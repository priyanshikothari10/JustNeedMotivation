pipeline {

    agent {
        label 'DevServer'
    }

    parameters {
        choice(
            choices: ['dev', 'prod'],
            name: 'select_environment'
        )
    }

    environment {
        NAME = 'JustNeedMotivation'
    }

    stages {

        stage('Install Dependencies') {
            steps {
                sh 'npm ci'
                echo 'Dependencies installed successfully.'
            }
        }

        stage('Lint') {
            steps {
                sh 'npm run lint'
                echo 'Lint completed successfully.'
            }
        }

        stage('Build') {
            steps {
                sh 'npm run build'
                echo "Hello From $NAME"
                echo 'Build completed successfully.'
            }
        }

        stage('Stash Build') {
            steps {
                stash(
                    name: 'next-build',
                    includes: '.next/**'
                )

                echo 'Next.js build files stashed successfully.'
            }
        }

        stage('Test') {
            parallel {

                stage('Test A') {
                    agent {
                        label 'DevServer'
                    }

                    steps {
                        echo 'This is test A'
                        echo 'Test A completed successfully.'
                    }
                }

                stage('Test B') {
                    agent {
                        label 'DevServer'
                    }

                    steps {
                        echo 'This is test B'
                        echo 'Test B completed successfully.'
                    }
                }
            }
        }

        stage('Deploy') {
            steps {
                dir('/var/www/html') {

                    deleteDir()

                    unstash 'next-build'

                    sh 'ls -la'
                    sh 'ls -la .next'
                }

                echo "Deployment completed for ${params.select_environment} environment."
            }
        }
    }

    post {
        success {
            echo '🎉 Pipeline completed successfully!'
        }

        failure {
            echo '❌ Pipeline failed. Check the stage logs.'
        }

        always {
            echo 'Pipeline execution finished.'
        }
    }
}