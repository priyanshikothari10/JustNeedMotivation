pipeline {
    agent {
        label 'DevServer'
    }

    parameters {
          choice choices: ['dev', 'prod'], name: 'select_environment'
    }

    environment {
        NAME = 'JustNeedMotivation'
    }

    stages {

        stage('Install Dependencies') {
            steps {
                sh 'npm ci'
                echo "Dependencies installed successfully."
            }
        }

        stage('Lint') {
            steps {
                sh 'npm run lint'
            }
        }

        stage('Build') {
            steps {
                sh 'npm run build'
                echo "Hello From $NAME"
            }
        }

        stage('Test') {
            parallel {

                stage('Test A') {
                    steps {
                        sh 'npm test'
                        echo "This is test A"

                    }
                }

                stage('Test B') {
                    steps {
                        sh 'npm test'
                         echo "This is test B"

                    }
                }
            }
        }
    }

    post {
    success {
        archiveArtifacts artifacts: '.next/**', fingerprint: true
    }
}
}