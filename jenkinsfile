pipeline {
    agent {
        label 'DevServer'
    }

    tools {
        maven 'My_maven'
    }

    stages {
        stage('Build') {
            steps {
                sh 'mvn clean install'
            }

            post {
                success {
                    archiveArtifacts artifacts: '**/target/*.war'
                }
            }
        }
    }
}