pipeline {
    agent {
        label 'DevServer'
    }
    parameters {
  string defaultValue: 'JUSTNEEDMOTIVATION', name: 'PROJECT '
}

    environment {
        NAME = 'JustNeedMotivation'
    }

    stages {

        stage('Install Dependencies') {
            steps {
                sh 'npm ci'
                echo "Dependencies installed successfully."
            }
        }

        stage('Lint') {
            steps {
                sh 'npm run lint'
            }
        }

        stage('Build') {
            steps {
                sh 'npm run build'
                echo "Hello $NAME"
            }
        }
    }
}